{
  "version": 2,
  "builds": [
    {
      "src": "react-editor/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/react-editor/assets/$1" },
    { "src": "/(.*)", "dest": "/react-editor/index.html" }
  ]
}